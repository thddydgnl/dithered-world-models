{
 "act_source": [
  "\t@torch.no_grad()",
  "\tdef act(self, obs, t0=False, eval_mode=False, task=None):",
  "\t\t\"\"\"",
  "\t\tSelect an action by planning in the latent space of the world model.",
  "",
  "\t\tArgs:",
  "\t\t\tobs (torch.Tensor): Observation from the environment.",
  "\t\t\tt0 (bool): Whether this is the first observation in the episode.",
  "\t\t\teval_mode (bool): Whether to use the mean of the action distribution.",
  "\t\t\ttask (int): Task index (only used for multi-task experiments).",
  "",
  "\t\tReturns:",
  "\t\t\ttorch.Tensor: Action to take in the environment.",
  "\t\t\"\"\"",
  "\t\tobs = obs.to(self.device, non_blocking=True).unsqueeze(0)",
  "\t\tif task is not None:",
  "\t\t\ttask = torch.tensor([task], device=self.device)",
  "\t\tif self.cfg.mpc:",
  "\t\t\treturn self.plan(obs, t0=t0, eval_mode=eval_mode, task=task).cpu()",
  "\t\tz = self.model.encode(obs, task)",
  "\t\taction, info = self.model.pi(z, task)",
  "\t\tif eval_mode:",
  "\t\t\taction = info[\"mean\"]",
  "\t\treturn action[0].cpu()"
 ],
