/paper/**/*.aux
/paper/**/*.out
/paper/**/*.synctex.gz
/paper/**/*.fls
/paper/**/*.fdb_latexmk
/paper/**/*.xdv

# arXiv bundle and the intermediates kept to pack it (rebuilt by paper/rss2027/build/build.sh)
